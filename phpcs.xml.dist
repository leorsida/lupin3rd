<?xml version="1.0"?>
<ruleset name="lupin3rd">

	<description>WordPress coding standards for the lupin3rd.org theme.</description>

	<arg name="cache" value=".phpcs-cache"/>
	<arg name="basepath" value="./"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="s"/>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>/css/*</exclude-pattern>
	<exclude-pattern>/js/*</exclude-pattern>
	<exclude-pattern>/src/*</exclude-pattern>
	<exclude-pattern>/docs/*</exclude-pattern>
	<exclude-pattern>/\.*</exclude-pattern>

	<!--
		Command-line helpers, not WordPress runtime code: they run under `php`
		with no WordPress loaded, so the rules about escaping output and using
		WP_Filesystem do not apply to them.
	-->
	<exclude-pattern>/tools/*</exclude-pattern>

	<rule ref="WordPress"/>

	<!-- Every string in this theme belongs to one domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lupin3rd"/>
			</property>
		</properties>
	</rule>

	<!--
		Prefixes.

		The sniff rejects anything shorter than four characters, so `l3` cannot
		be declared here even though it is the theme's prefix everywhere: meta
		keys (`l3_estimated_time`), query variables (`l3_format`, in published
		URLs), template variables. Those are contracts with the database and
		with readers' bookmarks; renaming them to satisfy a linter would be the
		tail wagging the dog.

		So: what genuinely lives in the global namespace and could collide with
		another plugin — the hooks this theme invokes — uses `lupin3rd_`, and is
		checked. Variables in template files are excluded: they are global only
		because WordPress includes templates in global scope, they all carry
		`l3_`, and the sniff cannot be told that.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lupin3rd"/>
				<element value="Lupin3rd"/>
			</property>
		</properties>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound"/>
	</rule>

	<!--
		`apply_filters( 'the_content', … )` applies a core filter; it does not
		invent a hook. The sniff cannot tell the two apart.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>*/single-tutorial\.php</exclude-pattern>
		<exclude-pattern>*/single-dossier\.php</exclude-pattern>
		<exclude-pattern>*/inc/class-schema\.php</exclude-pattern>
	</rule>

	<!--
		The short ternary is used here on functions that return false or an
		empty string — preg_split(), get_the_terms(), wp_get_referer() — where
		the alternative is calling them twice or naming a variable for one
		line. Where the falsy value could be meaningful, the code spells the
		comparison out.
	-->
	<rule ref="Universal.Operators.DisallowShortTernary">
		<severity>0</severity>
	</rule>

	<!-- Template files follow the WordPress hierarchy, not the class-file rule. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true"/>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.5"/>

	<!-- The stack is PHP 8.3; the theme promises 8.2 and up. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.2-"/>

</ruleset>
