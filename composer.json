{
	"name": "lupin3rd/theme",
	"description": "Quality tooling for the lupin3rd.org theme. The theme itself ships no PHP dependencies: nothing here is loaded at runtime.",
	"type": "wordpress-theme",
	"license": "MIT",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wordpress-stubs": "^6.7"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "@php ./vendor/bin/parallel-lint --exclude vendor --exclude node_modules --exclude languages .",
		"phpcs": "@php ./vendor/bin/phpcs -p",
		"phpcbf": "@php ./vendor/bin/phpcbf",
		"phpstan": "@php ./vendor/bin/phpstan analyse --memory-limit=1G",
		"qa": [
			"@lint",
			"@phpcs",
			"@phpstan"
		]
	}
}
