includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	paths:
		- inc
		- blocks
		- functions.php
	tmpDir: .phpstan-cache
	bootstrapFiles:
		- tools/phpstan-bootstrap.php

	# The WordPress stubs are loaded once, by the extension above, as a
	# bootstrap file. Listing them again under scanFiles parses ten megabytes of
	# stubs a second time in every parallel worker, which is how a 512M limit
	# runs out on a theme of sixty files.

	# Each worker holds its own copy of the stubs, so the number of workers is
	# a memory decision, not a speed one.
	parallel:
		maximumNumberOfProcesses: 4

	# wp_setup_nav_menu_item() hangs url, target, title and friends on a WP_Post
	# at runtime. They are not declared on the class and never will be, so the
	# object is read as a crate rather than pretended to be typed.
	universalObjectCratesClasses:
		- WP_Post

	# Template files are procedural and receive $args from get_template_part():
	# analysing them says little and complains much. They are covered by phpcs
	# and by the end-to-end tests, which load the pages they build.
	excludePaths:
		- template-parts
