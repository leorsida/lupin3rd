includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	paths:
		- inc
		- blocks
		- functions.php
	tmpDir: .phpstan-cache
	bootstrapFiles:
		- tools/phpstan-bootstrap.php
	scanFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php

	# Template files are procedural and receive $args from get_template_part():
	# analysing them says little and complains much. They are covered by phpcs
	# and by the end-to-end tests, which load the pages they build.
	excludePaths:
		- template-parts
